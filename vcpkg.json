{
    "name": "zhmmodsdk",
    "version": "1.0.0",
    "dependencies": [
        "directxtk12",
        "spdlog",
        "minhook",
        "lz4",
        "directx-headers",
        "protobuf",
        "zlib",
        "libuv",
        {
            "name": "usockets",
            "default-features": false,
            "features": []
        },
        "uwebsockets",
        "simdjson",
        "neargye-semver",
        "sentry-native",
        {
            "name": "imgui",
            "features": [
                "dx12-binding"
            ]
        },
        "imguizmo",
        "imgui-node-editor",
        "implot",
        {
            "name": "directxtex",
            "default-features": false,
            "features": [
                "dx12"
            ]
        }
    ],
    "vcpkg-configuration": {
        "overlay-ports": [
            "./cmake/vcpkg-ports"
        ]
    }
}