--- a/imgui.cpp
+++ b/imgui.cpp
@@ -7831,6 +7831,9 @@ bool ImGui::Begin(const char* name, bool* p_open, ImGuiWindowFlags flags)
     IM_ASSERT(g.WithinFrameScope);                  // Forgot to call ImGui::NewFrame()
